<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain C#, no Revit: fetching, the terrain grid, the situationsplan, the sampling and the levels. Revit 2025 runs
       .NET 8. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Jega.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- The user-facing text (Resources/Strings.resx, English; Strings.<culture>.resx for a translation), as the typed
       class Jega.Core.Resources.Strings, generated at build, as Jega.Revit's. Its namespace is the resource's own name
       (Jega.Core.Resources.Strings), so the class finds it; another namespace finds nothing at run time. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Jega.Core.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
